<Application x:Class="BasmaYouTubeDownloaderUltra.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Styles/WpfUi.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Electric Crimson & Dark Velvet Design System Palette -->
            <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="#0A0B0E" />
            <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="#12141A" />
            <SolidColorBrush x:Key="SurfaceCardBrush" Color="#1A1D26" />
            <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#E11D48" />
            <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#BE123C" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
            <SolidColorBrush x:Key="DangerRedBrush" Color="#EF4444" />
            <SolidColorBrush x:Key="WarningAmberBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="SuccessEmeraldBrush" Color="#10B981" />
            <SolidColorBrush x:Key="BorderDarkBrush" Color="#262A36" />

            <!-- Custom Font Styles -->
            <Style x:Key="HeaderTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display, Cascadia Code, Inter, sans-serif" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>

            <Style x:Key="SubHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display, Cascadia Code, Inter, sans-serif" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
