<Window x:Class="BasmaYouTubeDownloaderUltra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BasmaYouTubeDownloaderUltra.ViewModels"
        mc:Ignorable="d"
        Title="Basma YouTube Downloader Ultra Pro v2.0.0-PROD"
        Height="780" Width="1180"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#0A0B0E"
        Foreground="#F8FAFC">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Top Header & Banner -->
            <RowDefinition Height="Auto" />
            <!-- URL Search & Quality Matrix -->
            <RowDefinition Height="Auto" />
            <!-- Main Batch Queue -->
            <RowDefinition Height="*" />
            <!-- Telemetry & Action Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP HEADER & BRANDING BAR -->
        <Border Grid.Row="0" Background="#12141A" CornerRadius="8" Padding="16,12" Margin="0,0,0,12" BorderBrush="#262A36" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#E11D48" CornerRadius="6" Padding="10,6" Margin="0,0,12,0">
                        <TextBlock Text="BASMA ULTRA" FontWeight="Bold" FontSize="13" Foreground="White" />
                    </Border>
                    <TextBlock Text="YouTube Downloader Workstation v2.0.0-PROD" Style="{StaticResource HeaderTitleStyle}" VerticalAlignment="Center" FontSize="18" />
                </StackPanel>

                <!-- System Telemetry Status Badges -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- FFmpeg Badge -->
                    <Border Background="#1A1D26" CornerRadius="6" Padding="10,5" Margin="0,0,8,0" BorderBrush="#262A36" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="FFmpeg: " Foreground="#94A3B8" FontSize="11" />
                            <TextBlock Text="{Binding IsFFmpegInstalled, FallbackValue=Detected}" Foreground="#10B981" FontWeight="SemiBold" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <!-- Archive Count Badge -->
                    <Border Background="#1A1D26" CornerRadius="6" Padding="10,5" Margin="0,0,8,0" BorderBrush="#262A36" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Archive: " Foreground="#94A3B8" FontSize="11" />
                            <TextBlock Text="{Binding ArchiveCount, StringFormat={}{0} Items}" Foreground="#F59E0B" FontWeight="SemiBold" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding OpenOutputFolderCommand}" ToolTip="Open Downloads Folder" Padding="8,4" Background="#1A1D26" BorderBrush="#262A36">
                        <TextBlock Text="📁 Folder" Foreground="#F8FAFC" FontSize="11" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- URL INPUT & QUALITY MATRIX PANEL -->
        <Border Grid.Row="1" Background="#12141A" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#262A36" BorderThickness="1">
            <StackPanel>
                <!-- URL Entry Row -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding UrlInput, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Padding="12,10"
                             Background="#1A1D26" Foreground="#F8FAFC"
                             BorderBrush="#262A36" BorderThickness="1"
                             VerticalAlignment="Center">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <Button Grid.Column="1"
                            Command="{Binding AnalyzeUrlCommand}"
                            IsEnabled="{Binding IsAnalyzing, FallbackValue=True}"
                            Background="#E11D48" Foreground="White"
                            FontWeight="Bold" FontSize="13" Padding="20,10" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡ ANALYZE LINK" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Quality Matrix Options Row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Default Format: " Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" />
                        <ComboBox ItemsSource="{Binding AvailableFormats}"
                                  SelectedItem="{Binding SelectedGlobalFormat}"
                                  Width="180" Padding="8,6"
                                  Background="#1A1D26" Foreground="#F8FAFC"
                                  BorderBrush="#262A36" BorderThickness="1" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                        <CheckBox Content="Embed Metadata &amp; Artwork" IsChecked="{Binding Settings.AutoEmbedMetadata}" Foreground="#F8FAFC" Margin="0,0,16,0" FontSize="12" />
                        <CheckBox Content="Download Subtitles (.vtt)" IsChecked="{Binding Settings.DownloadSubtitles}" Foreground="#F8FAFC" Margin="0,0,16,0" FontSize="12" />
                        <CheckBox Content="Archive Protection (Skip Dupes)" IsChecked="{Binding Settings.UseArchiveTracker}" Foreground="#F8FAFC" FontSize="12" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="Concurrency: " Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                        <TextBox Text="{Binding Settings.MaxConcurrentDownloads, UpdateSourceTrigger=PropertyChanged}" Width="40" Padding="4" Background="#1A1D26" Foreground="#F8FAFC" BorderBrush="#262A36" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- MAIN BATCH QUEUE LISTVIEW -->
        <Border Grid.Row="2" Background="#12141A" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#262A36" BorderThickness="1">
            <ListView ItemsSource="{Binding Queue}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MediaItemViewModel}">
                        <Border Background="#1A1D26" CornerRadius="8" Padding="12" BorderBrush="#262A36" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /> <!-- Checkbox -->
                                    <ColumnDefinition Width="100" />  <!-- Thumbnail -->
                                    <ColumnDefinition Width="*" />    <!-- Details & Progress -->
                                    <ColumnDefinition Width="160" />  <!-- Format Selector -->
                                    <ColumnDefinition Width="Auto" /> <!-- Actions -->
                                </Grid.ColumnDefinitions>

                                <!-- Checkbox -->
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="4,0,12,0" />

                                <!-- Thumbnail -->
                                <Border Grid.Column="1" CornerRadius="6" ClipToBounds="True" Height="58" Background="#0A0B0E">
                                    <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                                </Border>

                                <!-- Details & Progress -->
                                <StackPanel Grid.Column="2" Margin="14,0,14,0" VerticalAlignment="Center">
                                    <!-- Title & Duration -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="Bold" Foreground="#F8FAFC" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding DurationFormatted}" Foreground="#94A3B8" FontSize="11" Margin="8,0,0,0" />
                                    </Grid>

                                    <!-- Author & Status Text -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Author}" Foreground="#94A3B8" FontSize="11" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{Binding StatusBadgeColor}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding BytesFormatted}" Foreground="#94A3B8" FontSize="11" />
                                    </Grid>

                                    <!-- Progress Bar & Speed / ETA -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ProgressBar Grid.Column="0" Value="{Binding ProgressPercent}" Maximum="100" Height="6" Background="#0A0B0E" Foreground="#E11D48" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding SpeedFormatted}" Foreground="#E11D48" FontWeight="SemiBold" FontSize="11" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding EtaFormatted, StringFormat=ETA: {0}}" Foreground="#94A3B8" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- Per-Item Format Selector -->
                                <ComboBox Grid.Column="3"
                                          ItemsSource="{Binding DataContext.AvailableFormats, RelativeSource={RelativeSource AncestorType=ListView}}"
                                          SelectedItem="{Binding SelectedFormat}"
                                          VerticalAlignment="Center" Margin="0,0,12,0"
                                          Background="#0A0B0E" Foreground="#F8FAFC" BorderBrush="#262A36" />

                                <!-- Actions -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding DataContext.OpenDownloadedFileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Play/Open File" Padding="8,6" Background="#262A36" Margin="0,0,6,0">
                                        <TextBlock Text="▶ Play" Foreground="#F8FAFC" FontSize="11" />
                                    </Button>
                                    <Button Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Remove Item" Padding="8,6" Background="#262A36">
                                        <TextBlock Text="✕" Foreground="#EF4444" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- TELEMETRY & BOTTOM ACTION BAR -->
        <Border Grid.Row="3" Background="#12141A" CornerRadius="8" Padding="16,12" BorderBrush="#262A36" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Queue Control Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding StartDownloadQueueCommand}" IsEnabled="{Binding IsDownloading, FallbackValue=True}" Background="#E11D48" Foreground="White" FontWeight="Bold" FontSize="13" Padding="18,8" Margin="0,0,10,0">
                        <TextBlock Text="▶ START DOWNLOAD QUEUE" FontWeight="Bold" />
                    </Button>
                    <Button Command="{Binding CancelQueueCommand}" IsEnabled="{Binding IsDownloading}" Background="#EF4444" Foreground="White" FontWeight="Bold" FontSize="12" Padding="12,8" Margin="0,0,10,0">
                        <TextBlock Text="⏹ Cancel" />
                    </Button>
                    <Button Command="{Binding SelectAllCommand}" Padding="10,8" Margin="0,0,6,0" Background="#1A1D26" BorderBrush="#262A36">
                        <TextBlock Text="Select All" Foreground="#F8FAFC" FontSize="11" />
                    </Button>
                    <Button Command="{Binding UnselectAllCommand}" Padding="10,8" Margin="0,0,6,0" Background="#1A1D26" BorderBrush="#262A36">
                        <TextBlock Text="Unselect All" Foreground="#F8FAFC" FontSize="11" />
                    </Button>
                    <Button Command="{Binding ClearQueueCommand}" Padding="10,8" Background="#1A1D26" BorderBrush="#262A36">
                        <TextBlock Text="Clear Queue" Foreground="#F8FAFC" FontSize="11" />
                    </Button>
                </StackPanel>

                <!-- Status & Telemetry Information -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Real-Time Speedometer -->
                    <Border Background="#1A1D26" CornerRadius="6" Padding="12,6" Margin="0,0,12,0" BorderBrush="#262A36" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡ SPEED: " Foreground="#94A3B8" FontSize="11" />
                            <TextBlock Text="{Binding TotalSpeedFormatted}" Foreground="#E11D48" FontWeight="Bold" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <!-- Active Worker Threads -->
                    <Border Background="#1A1D26" CornerRadius="6" Padding="12,6" Margin="0,0,12,0" BorderBrush="#262A36" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧵 THREADS: " Foreground="#94A3B8" FontSize="11" />
                            <TextBlock Text="{Binding ActiveWorkersCount, StringFormat={}{0} Active}" Foreground="#F59E0B" FontWeight="Bold" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <!-- Queue Progress Counters -->
                    <Border Background="#1A1D26" CornerRadius="6" Padding="12,6" BorderBrush="#262A36" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Completed: " Foreground="#94A3B8" FontSize="11" />
                            <TextBlock Text="{Binding CompletedCount}" Foreground="#10B981" FontWeight="Bold" FontSize="11" Margin="0,0,8,0" />
                            <TextBlock Text="Skipped: " Foreground="#94A3B8" FontSize="11" />
                            <TextBlock Text="{Binding SkippedCount}" Foreground="#64748B" FontWeight="Bold" FontSize="11" Margin="0,0,8,0" />
                            <TextBlock Text="Failed: " Foreground="#94A3B8" FontSize="11" />
                            <TextBlock Text="{Binding FailedCount}" Foreground="#EF4444" FontWeight="Bold" FontSize="11" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
